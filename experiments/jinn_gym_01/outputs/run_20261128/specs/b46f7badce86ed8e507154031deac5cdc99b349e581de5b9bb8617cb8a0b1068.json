 "evidence_requirements": {
  "min_evidence_items": 1,
  "abstain_on_missing_inputs": true,
  "require_failure_log_for_repair": true
 },
 "abstention": {
  "min_train_score": 0.3,
  "abstain_if_no_ranked_action": false
 },
 "repair_rules": [
  {
   "diagnostic": "overconfident",
   "patch": "raise_abstain_threshold",
   "target": "unverified_claim",
   "max_step": 0.2
  },
  {
   "diagnostic": "underconfident",
   "patch": "lower_abstain_threshold",
   "target": "unverified_claim",
   "max_step": 0.2
  },
  {
   "diagnostic": "missed_signature",
   "patch": "add_positive_tag",
   "target": "explicit_construction",
   "max_step": 0.4
  },
  {
   "diagnostic": "vetoed_best",
   "patch": "remove_critical_tag",
   "target": "heuristic_guess",
   "max_step": 0.2
  },
  {
   "diagnostic": "lattice_blocked_best",
   "patch": "add_transition",
   "target": "construct",
   "max_step": 0.3
  },
  {
   "diagnostic": "wrong_abstain",
   "patch": "lower_abstain_threshold",
   "target": "explicit_construction",
   "max_step": 0.2
  }
 ],
 "ambiguity_behavior": [
  {
   "situation": "missing required inputs",
   "expected_action": "abstain_pending_evidence or request_information"
  },
  {
   "situation": "several plausible constructions",
   "expected_action": "build_example then controlled_comparison"
  },
  {
   "situation": "claim lacks witness",
   "expected_action": "explicit_construction or certificate_check before commit_result"
