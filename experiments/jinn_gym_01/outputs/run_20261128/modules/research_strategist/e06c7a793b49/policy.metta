(lattice-transition repair test)
(evidence-min 2)
(abstain-on-missing-inputs true)
(require-failure-log-for-repair true)
(abstain-min-train 0.35)
(abstain-if-no-ranked-action true)
(rank 0 information_gain_estimate)
(rank 1 decisive_experiment)
(rank 2 controlled_comparison)
(rank 3 counterexample_search)
(rank 4 certificate_check)
(rank 5 bounded_repair)
(rank 6 failure_diagnosis)
(rank 7 abstain_pending_evidence)
(rank 8 budget_allocation)
(repair-rule missed_signature add_positive_tag information_gain_estimate 0.2)
(repair-rule suboptimal_utility raise_weight info_gain_per_cost 0.2)
(repair-rule overconfident raise_abstain_threshold abstain_pending_evidence 0.2)
(repair-rule underconfident lower_abstain_threshold abstain_pending_evidence 0.15)
(repair-rule wrong_abstain lower_abstain_threshold abstain_pending_evidence 0.15)
(repair-rule lattice_blocked_best add_transition certificate_check 0.2)
