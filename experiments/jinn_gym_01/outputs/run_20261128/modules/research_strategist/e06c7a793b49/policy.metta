(lattice-state hypothesize)
(lattice-state construct)
(lattice-state test)
(lattice-state verify)
(lattice-state diagnose)
(lattice-state repair)
(lattice-state abstain)
(lattice-state commit)
(lattice-initial orient)
(lattice-transition orient hypothesize)
(lattice-transition orient construct)
(lattice-transition orient test)
(lattice-transition orient abstain)
(lattice-transition hypothesize test)
(lattice-transition hypothesize abstain)
(lattice-transition construct test)
