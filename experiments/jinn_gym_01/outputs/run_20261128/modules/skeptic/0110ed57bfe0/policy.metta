(evidence-min 1)
(abstain-on-missing-inputs true)
(require-failure-log-for-repair true)
(abstain-min-train 0.15)
(abstain-if-no-ranked-action false)
(rank 0 counterexample_search)
(rank 1 stress_test_assumption)
(rank 2 controlled_comparison)
(rank 3 causal_intervention)
(rank 4 certificate_check)
(rank 5 explicit_construction)
(rank 6 build_example)
(rank 7 failure_diagnosis)
(rank 8 abstain_pending_evidence)
(repair-rule missed_signature raise_weight counterexample_drive 0.3)
(repair-rule overconfident add_critical_tag unverified_claim 0.2)
(repair-rule underconfident lower_weight verification_rigor 0.2)
(repair-rule wrong_abstain remove_tag broad_survey 0.2)
(repair-rule missed_abstain raise_weight verification_rigor 0.25)
