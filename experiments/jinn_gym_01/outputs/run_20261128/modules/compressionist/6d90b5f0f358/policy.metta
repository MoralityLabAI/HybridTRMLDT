(evidence-min 2)
(abstain-on-missing-inputs true)
(require-failure-log-for-repair true)
(abstain-min-train 0.25)
(abstain-if-no-ranked-action true)
(rank 0 compress_description)
(rank 1 reduce_compute)
(rank 2 certificate_check)
(rank 3 explicit_construction)
(rank 4 controlled_comparison)
(rank 5 counterexample_search)
(rank 6 budget_allocation)
(rank 7 information_gain_estimate)
(rank 8 formal_proof)
(repair-rule missed_signature raise_weight minimize_cost 0.3)
(repair-rule suboptimal_utility lower_weight minimize_cost 0.2)
(repair-rule overconfident raise_abstain_threshold evidence_discipline 0.25)
(repair-rule underconfident lower_abstain_threshold evidence_discipline 0.2)
(repair-rule wrong_abstain lower_abstain_threshold budget_sense 0.2)
(repair-rule lattice_blocked_best add_transition commit 0.15)
