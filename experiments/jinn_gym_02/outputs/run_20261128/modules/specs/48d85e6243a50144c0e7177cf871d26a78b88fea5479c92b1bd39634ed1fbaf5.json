  "min_train_score": 0.3,
  "abstain_if_no_ranked_action": false
 },
 "repair_rules": [
  {
   "diagnostic": "missed_signature",
   "patch": "add_positive_tag",
   "target": "information_gain_estimate",
   "max_step": 0.2
  },
  {
   "diagnostic": "suboptimal_utility",
   "patch": "raise_weight",
   "target": "info_gain_per_cost",
   "max_step": 0.2
  },
  {
   "diagnostic": "overconfident",
   "patch": "raise_abstain_threshold",
   "target": "abstain_pending_evidence",
   "max_step": 0.2
  },
  {
   "diagnostic": "underconfident",
   "patch": "lower_abstain_threshold",
   "target": "abstain_pending_evidence",
   "max_step": 0.15
  },
  {
   "diagnostic": "wrong_abstain",
   "patch": "lower_abstain_threshold",
   "target": "abstain_pending_evidence",
   "max_step": 0.15
  },
  {
   "diagnostic": "lattice_blocked_best",
   "patch": "add_transition",
   "target": "certificate_check",
   "max_step": 0.2
  }
 ],
 "ambiguity_behavior": [
  {
   "situation": "missing inputs or required evidence",
   "expected_action": "abstain_pending_evidence"
  },
  {
   "situation": "conflicting evidence with no decisive test",
   "expected_action": "information_gain_estimate then controlled_comparison"
  },
  {
   "situation": "high-cost option versus cheap foregone gain",
   "expected_action": "budget_allocation and reduce_compute"
  },
  {
   "situation": "result not machine-checked",
   "expected_action": "certificate_check or abstain instead of commit_result"
  }
 ],
