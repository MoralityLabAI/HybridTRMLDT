 "evidence_requirements": {
  "min_evidence_items": 1,
  "abstain_on_missing_inputs": true,
  "require_failure_log_for_repair": true
 },
 "abstention": {
  "min_train_score": 0.05,
  "abstain_if_no_ranked_action": false
 },
 "repair_rules": [
  {
   "diagnostic": "missed_signature",
   "patch": "add_positive_tag",
   "target": "proof_discipline",
   "max_step": 0.2
  },
  {
   "diagnostic": "suboptimal_utility",
   "patch": "lower_weight",
   "target": "proof_discipline",
   "max_step": 0.2
  },
  {
   "diagnostic": "overconfident",
   "patch": "raise_abstain_threshold",
   "target": "certificate_verification",
   "max_step": 0.1
  },
  {
   "diagnostic": "underconfident",
   "patch": "lower_abstain_threshold",
   "target": "proof_discipline",
   "max_step": 0.1
  },
  {
   "diagnostic": "lattice_blocked_best",
   "patch": "add_transition",
   "target": "commit_result",
   "max_step": 0.2
  }
 ],
 "ambiguity_behavior": [
  {
   "situation": "required inputs are missing or inconsistent",
   "expected_action": "request_information or abstain_pending_evidence"
  },
  {
   "situation": "evidence is plausible but not machine-checkable",
   "expected_action": "certificate_check or formal_proof before commit"
  },
  {
   "situation": "best action is blocked by the lattice",
   "expected_action": "add a narrow transition rather than bypass verification"
  },
  {
   "situation": "task asks for a conclusion without enough checks",
   "expected_action": "abstain_pending_evidence"
  }
 ],
 "predictions": [
  {
   "id": "proof_signature",
   "statement": "Formal proof or certificate checks dominate completed actions.",
   "metric": "signature_rate",
   "comparator": ">=",
   "threshold": 0.7,
   "domain": "all"
  },
  {
   "id": "missing_evidence_abstain",
   "statement": "The persona abstains more when inputs are missing than on fully specified tasks.",
   "metric": "abstain_rate",
   "comparator": ">=",
   "threshold": 0.25,
   "domain": "evidence_curation"
  },
  {
   "id": "utility_floor",
   "statement": "Held-out tasks retain a moderate mean utility despite conservative checking.",
   "metric": "mean_utility",
   "comparator": ">=",
   "threshold": 0.55,
   "domain": "all"
  },
  {
   "id": "cost_control",
